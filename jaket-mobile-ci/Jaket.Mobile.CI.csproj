<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>Jaket.Mobile</AssemblyName>
    <RootNamespace>Jaket</RootNamespace>
    <Description>JAKET Mobile v0.1 Android/IL2CPP CI build</Description>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <NoWarn>IDE0028;IDE0044;IDE0130;IDE0290;IDE0300;IDE1006</NoWarn>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json;https://nuget.bepinex.dev/v3/index.json;https://nuget.samboy.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NextBepLoader.Core.IL2CPP" Version="0.0.1" />
    <PackageReference Include="HarmonyX" Version="2.13.0" />
    <PackageReference Include="Il2CppInterop.Runtime" Version="1.4.6-ci.579" />
    <PackageReference Include="Il2CppInterop.HarmonySupport" Version="1.4.6-ci.579" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.29" />
    <PackageReference Include="Unity.InputSystem" Version="1.5.0" />
    <PackageReference Include="Ultrakill.GameLibs-Stripped-Publicized" Version="0.0.16-d" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="src/Jaket/Assets/BundleBuilder.cs" />
  </ItemGroup>
</Project>
